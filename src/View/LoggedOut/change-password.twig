{% extends "LoggedOut/basic.twig" %}

{% block form %}

    <h3 class="login-box-msg">{% trans %}Cambiar contraseña{% endtrans %}</h3>

    {% if wrong_link %}
        <div class="alert alert-danger">
            <h4><i class="icon fa fa-ban"></i>{% trans %}Error{% endtrans %}</h4>
            <p>{% trans %}Link incorrecto.{% endtrans %} <a href="{{ domain }}{% trans %}he-olvidado-mi-contrasena{% endtrans %}">{% trans %}Puedes obtener otro aquí.{% endtrans %}</a></p>
        </div>
    {% else %}
        <form method="POST">
            {% if form_error %}
                <div class="alert alert-danger">
                    <h4><i class="icon fa fa-ban"></i>{% trans %}Error{% endtrans %}</h4>
                    <p>{{ form_error }}</p>
                </div>
            {% elseif form_send %}
                <div class="alert alert-success">
                    <h4><i class="icon fa fa-check"></i>{% trans %}¡Hecho!{% endtrans %}</h4>
                    <p>{% trans %}Tu contraseña se ha cambiado correctamente.{% endtrans %} <a href="{{ domain }}{% trans %}iniciar-sesion{% endtrans %}">{% trans %}Puedes iniciar sessión aquí.{% endtrans %}</a></p>
                </div>
            {% endif %}

            <div class="form-group has-feedback">
                <input type="password" name="password1" class="form-control input-lg" placeholder="{% trans %}Contraseña{% endtrans %}" value="" />
                <span class="glyphicon glyphicon-lock form-control-feedback"></span>
            </div>
            <div class="form-group has-feedback">
                <input type="password" name="password2" class="form-control input-lg" placeholder="{% trans %}Repite la contraseña{% endtrans %}" value="" />
                <span class="glyphicon glyphicon-lock form-control-feedback"></span>
            </div>
            <div>
                <button type="submit" name="change" class="btn btn-primary btn-block btn-flat">{% trans %}Cambiar contraseña{% endtrans %}</button>
            </div>
        </form>
    {% endif %}

    <br/>
    <a href="{{ domain }}{% trans %}iniciar-sesion{% endtrans %}">{% trans %}Volver{% endtrans %}</a><br>

{% endblock %}