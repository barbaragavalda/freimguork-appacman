{% extends 'LoggedOut/basic.twig' %}

{% block form %}
    <h3 class="login-box-msg">{% trans %}Iniciar sesión{% endtrans %}</h3>

    <form method="POST">
        {% if form_error %}
            <div class="alert alert-danger">
                <h4><i class="icon fa fa-ban"></i>{% trans %}Error{% endtrans %}</h4>
                <p>{{ form_error }}</p>
            </div>
        {% endif %}
        <div class="form-group has-feedback">
            <input type="email" name="user" class="form-control input-lg" placeholder="{% trans %}Email{% endtrans %}" value="{{ form['user'] }}" />
            <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
        </div>
        <div class="form-group has-feedback">
            <input type="password" name="password" class="form-control input-lg" placeholder="{% trans %}Contraseña{% endtrans %}" value="{{ form['password'] }}" />
            <span class="glyphicon glyphicon-lock form-control-feedback"></span>
        </div>
        <div>
            <button type="submit" name="enter" class="btn btn-primary btn-block btn-flat">{% trans %}Acceder{% endtrans %}</button>
        </div>
    </form>

    <br/>
    <a href="{{ domain }}{% trans %}he-olvidado-mi-contrasena{% endtrans %}">{% trans %}He olvidado mi contraseña{% endtrans %}</a><br>

{% endblock %}