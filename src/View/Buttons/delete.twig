{% if canDelete %}
    {% if small %}
        <a href="#" data-id="{{ itemID }}" class="btn btn-danger btn-xs delete-item" title="{% trans %}Eliminar{% endtrans %}" data-toggle="confirmation"><i class="fa fa-trash"></i></a>
    {% else %}
        {% if itemID %}
            <a href="#" data-id="{{ itemID }}" class="btn btn-danger delete-item" title="{% trans %}Eliminar{% endtrans %}" data-toggle="confirmation"><i class="fa fa-trash"></i> {% trans %}Eliminar{% endtrans %}</a>
        {% endif %}
    {% endif %}
{% endif %}