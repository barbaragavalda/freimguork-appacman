{% if canDuplicate and not (tr.canDuplicate is defined and tr.canDuplicate == false) %}
    <a href="{{ domain }}{% trans %}duplicar{% endtrans %}/{{ contentID }}/{{ itemID }}" class="btn bg-maroon-active btn-xs" title="{% trans %}Duplicar{% endtrans %}"><i class="fa fa-files-o"></i></a>
{% endif %}