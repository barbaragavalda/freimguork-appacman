{% extends "basic-loggedin.twig" %}

{% block extra_head %}
    <!-- summernote - text editor -->
    <link href="{{ admin_domain }}js/plugins/summernote/dist/summernote.css" rel="stylesheet">
    <!-- Select2 -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/select2/dist/css/select2.min.css">
    <!-- iCheck for checkboxes and radio inputs -->
    <link rel="stylesheet" href="{{ vendor_domain }}plugins/iCheck/all.css">
    <!-- bootstrap datepicker -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css">
    <!-- bootstrap timepicker -->
    <link rel="stylesheet" href="{{ admin_domain }}js/datetimepicker/build/css/bootstrap-datetimepicker.min.css">

    {{ parent() }}
{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- google maps -->
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&libraries=places" ></script>
    <!-- summernote - text editor -->
    <script src="{{ admin_domain }}js/plugins/summernote/dist/summernote.min.js"></script>
    <!-- Select2 -->
    <script src="{{ vendor_domain }}bower_components/select2/dist/js/select2.full.min.js"></script>
    <!-- iCheck 1.0.1 -->
    <script src="{{ vendor_domain }}plugins/iCheck/icheck.min.js"></script>
    <!-- bootstrap datepicker -->
    <script src="{{ vendor_domain }}bower_components/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="{{ vendor_domain }}bower_components/bootstrap-datepicker/js/locales/bootstrap-datepicker.{{ lang }}.js"></script>
    <!-- bootstrap datetimepicker -->
    <script src="{{ vendor_domain }}bower_components/moment/moment.js"></script>
    <script src="{{ vendor_domain }}bower_components/bootstrap/js/transition.js"></script>
    <script src="{{ vendor_domain }}bower_components/bootstrap/js/collapse.js"></script>
    <script src="{{ admin_domain }}js/datetimepicker/build/js/bootstrap-datetimepicker.min.js"></script>
    <!-- Custom js -->
    <script src="{{ admin_domain }}js/common.js"></script>
    <script src="{{ admin_domain }}js/form.js?v=2"></script>
    <script>
        // datepicker
        $('.datepicker').datepicker({
            autoclose: true,
            language: '{{ lang }}'
        });
        // datetimepicker
        $('.datetimepicker').each(function(){
            $(this).datetimepicker({
                format: 'YYYY-MM-DD HH:mm:ss',
                defaultDate: $(this).val()
            });
        });

        // textarea
        var textarea = new Namespace.Textarea();
        textarea.completeTextarea('{{ domain }}{% trans %}subir-archivo{% endtrans %}/{{ contentID }}/{{ itemID }}');
        textarea.simpleTextarea();

        // delete item
        var deleteModel = new Namespace.Delete('{% trans %}Error{% endtrans %}', '{% trans %}No se ha podido eliminar el item. Por favor, inténtalo más tarde.{% endtrans %}', '{% trans %}Cerrar{% endtrans %}');
        deleteModel.item(
            'bottom',
            '{% trans %}Este proceso es irreversible{% endtrans %}',
            '{% trans %}Sí{% endtrans %}',
            '{% trans %}No{% endtrans %}',
            '{{ domain }}{% trans %}eliminar-item{% endtrans %}/{{ contentID }}/',
            function () {
                window.location = '{{ domain }}{% trans %}listado{% endtrans %}/{{ contentID }}';
            }
        );

        // delete file
        var deleteModel = new Namespace.Delete('{% trans %}Error{% endtrans %}', '{% trans %}No se ha podido eliminar el item. Por favor, inténtalo más tarde.{% endtrans %}', '{% trans %}Cerrar{% endtrans %}');
        deleteModel.file(
            'right',
            '{% trans %}Este proceso es irreversible{% endtrans %}',
            '{% trans %}Sí{% endtrans %}',
            '{% trans %}No{% endtrans %}',
            '{{ domain }}{% trans %}eliminar-archivo{% endtrans %}/{{ contentID }}/{{ itemID }}'
        );
    </script>
{% endblock %}

{% block page_content %}

    {% if languages|length > 1 %}
        <div class="box box-languages">
            <div class="box-body bg-gray form-horizontal">
                <div class="form-group">
                    <label class="col-sm-2 control-label">IDIOMAS</label>
                    <div class="col-sm-10">
                            <div class="btn-group">
                                {% for lang in languages %}
                                    <button value="{{ lang['id'] }}" type="button" class="btn btn-default">{{ lang['name'] }}</button>
                                {% endfor %}
                            </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% set formButtons %}
        {% include "Buttons/form-btn-group.twig" with {'itemID': itemID} %}
    {% endset %}
    <div class="box">
        <form class="form-horizontal" method="POST" enctype="multipart/form-data">
            {% if formSend %}
                {% if formError or not formSuccess %}
                    <div class="margin alert alert-danger">
                        <h4><i class="icon fa fa-ban"></i>
                            {% if formError is not defined %}
                                {% trans %}Ha habido un error al guardar los datos. Por favor, inténtalo de nuevo más tarde.{% endtrans %}
                            {% else %}
                                {{ formError }}
                            {% endif %}
                        </h4>
                    </div>
                {% endif %}
            {% endif %}

            {% if pendingMessage %}
                <div class="margin alert alert-success">
                    <h4><i class="icon fa fa-check"></i> {{ pendingMessage }}</h4>
                </div>
            {% endif %}

            <div class="box-header with-border">{{ formButtons }}</div>
            {% for input in form %}
                {% if input.isVisible() %}
                    {% set required = '' %}
                    {% if canEdit and input.isRequired() %}{% set required = ' required' %}{% endif %}
                    <div class="with-border">
                        <div class="box-header{{ required }}">
                            <div class="box-title">{{ input.name()|raw }}</div>
                        </div>
                        <div class="box-body">
                            <div class="form-group">
                                {% if canEdit or canSend %}
                                    {{ input.getFormHTML()|raw }}
                                {% else %}
                                    {{ input.getSeeHTML()|raw }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    {{ input.getHTML()|raw }}
                {% endif %}
            {% endfor %}
            {% block extra_form %}{% endblock %}

            <div class="box-footer">{{ formButtons }}</div>
        </form>
    </div>

    {% block bottom_form %}{% endblock %}

{% endblock %}