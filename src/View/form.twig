{% extends "basic-loggedin.twig" %}

{% block extra_head %}
    <!-- bootstrap wysihtml5 - text editor -->
    <link rel="stylesheet" href="{{ vendor_domain }}plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css">
    <!-- Select2 -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/select2/dist/css/select2.min.css">

    {{ parent() }}
{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- Bootstrap WYSIHTML5 -->
    <script src="{{ vendor_domain }}plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
    <!-- Select2 -->
    <script src="{{ vendor_domain }}bower_components/select2/dist/js/select2.full.min.js"></script>
    <!-- Custom js -->
    <script src="{{ admin_domain }}js/plugins/bootstrap-confirmation.min.js"></script>
    <script src="{{ admin_domain }}js/form.js"></script>
    <script>
        $('.delete-image').confirmation({
            rootSelector: '[data-toggle=confirmation]',
            singleton: true,
            popout: true,
            placement: 'right',
            btnOkClass: 'btn btn-danger',
            btnCancelClass: 'btn btn-default',
            content: '{% trans %}Este proceso es irreversible{% endtrans %}',
            btnOkLabel: '{% trans %}Sí{% endtrans %}',
            btnCancelLabel: '{% trans %}No{% endtrans %}',
            onConfirm: function(){
                var id = $(this).attr('data-id'),
                    name = $(this).attr('data-name'),
                    that = $(this);

                $.ajax({
                    type:       'POST',
                    url:        '{{ domain }}{% trans %}eliminar-archivo{% endtrans %}/{{ contentID }}/{{ itemID }}',
                    data:       { fieldName: name, fieldID: id },
                    dataType:	'json'
                })
                .done( function( result ){
                    if( !result['error'] ){
                        that.parent().html('<input type="file" class="form-control" id="' + name + '" name="' + name + '" />');
                    }else{
                        fileError();
                    }
                })
                .fail( function() {
                    fileError();
                });
            }
        });

        function fileError(){
            alertError('{% trans %}Error{% endtrans %}', '{% trans %}No se ha podido eliminar el archivo. Por favor, inténtalo más tarde.{% endtrans %}', '{% trans %}Cerrar{% endtrans %}');
        }
    </script>
{% endblock %}

{% block page_content %}

    {% if languages|length %}
        <div class="box box-languages">
            <div class="box-body bg-gray form-horizontal">
                <div class="form-group">
                    <label class="col-sm-2 control-label">IDIOMAS</label>
                    <div class="col-sm-10">
                            <div class="btn-group">
                                {% for lang in languages %}
                                    <button value="{{ lang['id'] }}" type="button" class="btn btn-default">{{ lang['name'] }}</button>
                                {% endfor %}
                            </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% set formButtons %}
        {% include "Buttons/form-btn-group.twig" %}
    {% endset %}
    <div class="box">
        <form class="form-horizontal" method="POST" enctype="multipart/form-data">
            {% if formSend %}
                {% if formError %}
                    <div class="margin alert alert-danger">
                        <h4><i class="icon fa fa-ban"></i> {% trans %}Ha habido un error al guardar los datos. Por favor, inténtalo d enuevo más tarde.{% endtrans %}</h4>
                    </div>
                {% else %}
                    <div class="margin alert alert-success">
                        <h4><i class="icon fa fa-check"></i> {% trans %}Datos guardados correctamente.{% endtrans %}</h4>
                    </div>
                {% endif %}
            {% endif %}

            <div class="box-header with-border">{{ formButtons }}</div>
            {% for input in form %}
                {% if input.isVisible() %}
                    {% set required = '' %}
                    {% if canEdit and input.isRequired() %}{% set required = ' required' %}{% endif %}
                    <div class="with-border">
                        <div class="box-header{{ required }}">
                            <div class="box-title">{{ input.name() }}</div>
                        </div>
                        <div class="box-body">
                            <div class="form-group">
                                {% if canEdit %}
                                    {{ input.getFormHTML()|raw }}
                                {% else %}
                                    {{ input.getSeeHTML()|raw }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    {{ input.getHTML()|raw }}
                {% endif %}
            {% endfor %}
            <div class="box-footer">{{ formButtons }}</div>
        </form>
    </div>

{% endblock %}