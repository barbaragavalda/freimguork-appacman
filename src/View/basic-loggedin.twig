{% extends "basic.twig" %}

{% block body_class %}skin-custom sidebar-mini fixed{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- Bootstrap 3.3.7 -->
    <script src="{{ vendor_domain }}bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <!-- SlimScroll -->
    <script src="{{ vendor_domain }}bower_components/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <!-- confirmation -->
    <script src="{{ admin_domain }}js/plugins/bootstrap-confirmation.min.js"></script>
{% endblock %}

{% block content %}

    <header class="main-header">
        <!-- Logo -->
        <a href="{{ domain }}" class="logo">
            <!-- mini logo for sidebar mini 50x50 pixels -->
            <span class="logo-mini"><b>{{ business['name']|first }}</b></span>
            <!-- logo for regular state and mobile devices -->
            <span class="logo-lg"><b>{{ business['name'] }}</b></span>
        </a>

        <nav class="navbar navbar-static-top">
            <!-- Sidebar toggle button-->
            <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </a>

            <div class="navbar-custom-menu">
                <ul class="nav navbar-nav">
                    <li class="dropdown user user-menu">
                        <a href="#">
                            <img src="{{ business['logo'] }}" class="user-image" alt="{{ business['name'] }}" title="{{ business['name'] }}">
                            <span class="hidden-xs">{{ username }}</span>
                        </a>
                    </li>
                    <li class="messages-menu">
                        <a href="{{ domain }}{% trans %}cerrar-sesion{% endtrans %}">
                            <i class="fa fa-sign-out"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <aside class="main-sidebar">
        <section class="sidebar">
            <!-- menu -->
            <ul class="sidebar-menu" data-widget="tree">
                {% for block in menu %}
                    {% if block['list']|length %}
                        <!-- block name -->
                        {% if block['name'] is not null %}
                            <li class="header">{{ block['name']|upper }}</li>
                        {% endif %}
                        <!-- block links list -->
                        {% for li in block['list'] %}
                            {% set icon = 'fa-list' %}
                            {% if li['icon'] %}{% set icon = li['icon'] %}{% endif %}
                            {% set active = '' %}
                            {% if li['id_appacman_content'] == contentID %}{% set active = ' class="active"' %}{% endif %}
                            <li{{ active|raw }}>
                                <a href="{{ domain }}{% trans %}listado{% endtrans %}/{{ li['id_appacman_content'] }}">
                                    <i class="fa {{ icon }}"></i>
                                    <span>{{ li['name'] }}</span>
                                    {% if li['counter'] > 0 %}
                                        <span class="pull-right-container">
                                            <span class="label label-custom pull-right">{{ li['counter'] }}</span>
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </ul>
        </section>
    </aside>

    <div class="content-wrapper">
        <!-- breadcrumb -->
        <section class="content-header">
            {% set breadcrumbH1 = breadcrumb[breadcrumb|length -1]['name'] %}
            {% if not breadcrumbH1 %}
                {% set breadcrumbH1 = '&nbsp;' %}
            {% endif %}
            <h1>{{ breadcrumbH1|raw }}</h1>
            {% if breadcrumb|length > 0 %}
                <ol class="breadcrumb">
                    <li><a href="{{ domain }}">{% trans %}Inicio{% endtrans %}</a></li>
                    {% for li in breadcrumb %}
                        {% if li['link'] is null %}
                            <li class="active">{{ li['name'] }}</li>
                        {% else %}
                            <li><a href="{{ li['link'] }}">{{ li['name'] }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ol>
            {% endif %}
        </section>

        <section class="content">
            {% block page_content %}{% endblock %}
        </section>
    </div>

    <footer class="main-footer clearfix">
        <div class="pull-right">
            <b>{% trans %}Versión{% endtrans %}</b> 1.0 |
            <a href="#"><span class="fa fa-info-circle"></span></a>
        </div>
        <div class="pull-left">
            <b>{% trans %}Soporte técnico{% endtrans %}:</b> <a href="mailto:info@appaqui.com" target="_blank">info@appaqui.com</a>, <a href="tel:+34933935968" target="_blank">+34 93 393 59 68</a>
        </div>
    </footer>

{% endblock %}