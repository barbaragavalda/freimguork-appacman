{% extends 'List/basic.twig' %}

{% block list %}

    {% set ths %}
        <tr>
            {% for th in list_headers %}
                <th>{{ th['name']|raw }}</th>
            {% endfor %}
            <th>{% trans %}Acciones{% endtrans %}</th>
        </tr>
    {% endset %}

    <div class="table-responsive">
        <table id="list" class="table table-bordered table-hover">
            <thead>
            {{ ths }}
            </thead>
            <tbody></tbody>
            <tfoot>
            {{ ths }}
            </tfoot>
        </table>
    </div>

{% endblock %}