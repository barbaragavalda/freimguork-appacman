{% extends "List/table-structure.twig" %}

{% block table_content %}

    {% for tr in list %}
        {% set trID = '' %}
        {% if canSee or canEdit or canOwn %}{% set trID = 'id="' ~ tr['id'] ~ '" class="canGo"' %}{% endif %}
        <tr {{ trID|raw }}>
            {% for th in list_headers %}
                {% if th['field_name'] != 'is_locked' %}
                    <td>{{ tr[th['field_name']]|raw }}</td>
                {% endif %}
            {% endfor %}
            <td>
                {% set isLocked = false %}
                {% if tr['is_locked'] == 'Sí'|trans %}
                    {% set isLocked = true %}
                {% endif %}
                {% include "Buttons/see.twig" with {'itemID': tr['id']} %}
                {% include "Buttons/edit.twig" with {'itemID': tr['id'], 'small': true} %}
                {% include "Buttons/delete.twig" with {'itemID': tr['id'], 'small': true} %}
                {% include "Buttons/lock.twig" with {'itemID': tr['id'], 'small': true, isLocked: isLocked} %}
                {% include "Buttons/duplicate.twig" with {'itemID': tr['id']} %}
            </td>
        </tr>
    {% endfor %}

{% endblock %}