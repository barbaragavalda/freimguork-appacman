{% extends 'basic-loggedin.twig' %}

{% block extra_head %}
    <!-- DataTables -->
    <link rel="stylesheet" href="{{ vendorDomain }}bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">
    {{ parent() }}
{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- DataTables -->
    <script src="{{ vendorDomain }}bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="{{ vendorDomain }}bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <!-- Custom js -->
    <script src="{{ adminDomain }}js/common.js?v=2"></script>
    <script>
        // tables
        var orderColumns = [];
        {% for th in list_headers %}
            {% if th['field_name'] == 'is_locked' %}
                orderColumns.push({ orderable: false });
            {% else %}
                orderColumns.push({ orderable: true });
            {% endif %}
        {% endfor %}
        orderColumns.push({ orderable: false });
        $(function () {
            $('#list').DataTable({
                processing:     true,
                serverSide:     true,
                ajax: {
                    url: '{{ domain }}table/{{ contentID }}',
                    type: 'POST',
                    data: function(params){
                        return $.extend(params, {{ tableData|json_encode|raw }});
                    }
                },
                columnDefs: [
                    {
                        targets: '_all',
                        visible: true,
                        render: function(data, type, row, meta){
                            var keys = Object.keys(row),
                                key = keys[meta['col']+1],
                                value = row[key];

                            {% set id = '%itemID%' %}
                            var actions = '';
                            if( key === 'actions' ){
                                actions += '{{ include('Buttons/see.twig', {'itemID': id})|forJS|raw }}';
                                actions += '{{ include('Buttons/edit.twig', {'itemID': id, 'small': true})|forJS|raw }}';
                                actions += '{{ include('Buttons/delete.twig', {'itemID': id, 'small': true})|forJS|raw }}';
                                actions += '{{ include('Buttons/duplicate.twig', {'itemID': id})|forJS|raw }}';
                            }
                            if( key === 'is_locked' ){
                                if( row['is_locked'] === '1' ){
                                    actions += '{{ include('Buttons/lock.twig', {'itemID': id, 'small': true, isLocked: true})|forJS|raw }}';
                                }else{
                                    actions += '{{ include('Buttons/lock.twig', {'itemID': id, 'small': true, isLocked: false})|forJS|raw }}';
                                }
                            }
                            if( actions !== '' ){
                                return actions.replace('%itemID%', row['id']);
                            }
                            return value;
                        }
                    }
                ],
                paging:         true,
                pageLength:     25,
                stateSave:      true,
                lengthChange:   true,
                searching:      true,
                ordering:       true,
                info:           true,
                autoWidth:      false,
                columns:        orderColumns,
                order:          {{ list_order|json_encode|raw }},
                language: {
                    lengthMenu:     '{% trans %}Mostrar _MENU_ items por página{% endtrans %}',
                    zeroRecords:    '{% trans %}Sin resultados{% endtrans %}',
                    info:           '{% trans %}Mostrando _START_ a _END_ de _TOTAL_ entradas{% endtrans %}',
                    infoEmpty:      '{% trans %}No hay registros disponibles{% endtrans %}',
                    search:         '{% trans %}Buscar{% endtrans %}: ',
                    infoFiltered:   '{% trans %}(filtrado de _MAX_ entradas totales){% endtrans %}',
                    processing:     '{% trans %}Cargando{% endtrans %}...',
                    paginate: {
                        first:      '{% trans %}Primero{% endtrans %}',
                        last:       '{% trans %}Último{% endtrans %}',
                        previous:   '{% trans %}Anterior{% endtrans %}',
                        next:       '{% trans %}Siguiente{% endtrans %}'
                    }
                },
                createdRow: function(row, data) {
                    $(row).attr('id', data['id']);
                },
                drawCallback: function() {
                    $('#list tr').unbind('click').bind('click', function(e){
                        var id = $(this).attr('id');
                        if( $(e.target).is('td') && typeof(id) !== 'undefined' && id ){
                            window.location = '{{ domain ~ formLink ~ '/' ~ contentID ~ '/' }}' + id;
                        }
                    });
                }
            });

            // delete item
            var deleteModel = new Namespace.Delete('{% trans %}Error{% endtrans %}', '{% trans %}No se ha podido eliminar el item. Por favor, inténtalo más tarde.{% endtrans %}', '{% trans %}Cerrar{% endtrans %}');
            deleteModel.item(
                'left',
                '{% trans %}Este proceso es irreversible{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{{ domain }}{% trans %}eliminar-item{% endtrans %}/{{ contentID }}/',
                function () {
                    window.location.reload();
                }
            );

            // block item
            var blockModel = new Namespace.Block('{% trans %}Error{% endtrans %}', '{% trans %}Cerrar{% endtrans %}', '{{ domain }}{% trans %}bloquear{% endtrans %}/{{ contentID }}/');
            blockModel.block(
                '{% trans %}¿Seguro que quieres bloquear este item?{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{% trans %}No se ha podido bloquear el item. Por favor, inténtalo más tarde.{% endtrans %}'
            );
            blockModel.unblock(
                '{% trans %}¿Seguro que quieres desbloquear este item?{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{% trans %}No se ha podido desbloquear el item. Por favor, inténtalo más tarde.{% endtrans %}'
            );

        });
    </script>
{% endblock %}

{% block page_content %}
    {% block filters %}{% endblock %}

    {% set createButton %}
        <div class="clearfix">
            {% block extra_buttons %}{% endblock %}
            <div class="btn-group margin pull-right">
                {% include 'Buttons/create.twig' %}
                {% include 'Buttons/export.twig' %}
            </div>
        </div>
    {% endset %}
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                {{ createButton }}
                <div class="box-body">
                    {% block list %}{% endblock %}
                </div>
                {{ createButton }}
            </div>
        </div>
    </div>

{% endblock %}