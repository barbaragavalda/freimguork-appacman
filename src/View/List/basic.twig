{% extends "basic-loggedin.twig" %}

{% block extra_head %}
    <!-- DataTables -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">
    {{ parent() }}
{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- DataTables -->
    <script src="{{ vendor_domain }}bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="{{ vendor_domain }}bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <!-- Custom js -->
    <script src="{{ admin_domain }}js/common.js"></script>
    <script>
        // tables
        var columns = [];
        {% for th in list_headers %}
            {% if th['field_name'] != 'is_locked' %}
                columns.push({ "orderable": true });
            {% endif %}
        {% endfor %}
        columns.push({ "orderable": false });
        $(function () {
            $('#list').DataTable({
                'paging': true,
                'pageLength': 25,
                'stateSave': true,
                'lengthChange': true,
                'searching': true,
                'ordering': true,
                'info': true,
                'autoWidth': false,
                'columns': columns,
                'order': {{ list_order|json_encode|raw }},
                'language': {
                    'lengthMenu': "{% trans %}Mostrar _MENU_ items por página{% endtrans %}",
                    'zeroRecords': "{% trans %}Sin resultados{% endtrans %}",
                    'info': "{% trans %}Mostrando _START_ a _END_ de _TOTAL_ entradas{% endtrans %}",
                    'infoEmpty': "{% trans %}No hay registros disponibles{% endtrans %}",
                    'search': "{% trans %}Buscar{% endtrans %}: ",
                    'infoFiltered': "{% trans %}(filtrado de _MAX_ entradas totales){% endtrans %}",
                    'paginate': {
                        'first': "{% trans %}Primero{% endtrans %}",
                        'last': "{% trans %}Último{% endtrans %}",
                        'previous': "{% trans %}Anterior{% endtrans %}",
                        'next': "{% trans %}Siguiente{% endtrans %}"
                    }
                }
            });

            // delete item
            var deleteModel = new Namespace.Delete('{% trans %}Error{% endtrans %}', '{% trans %}No se ha podido eliminar el item. Por favor, inténtalo más tarde.{% endtrans %}', '{% trans %}Cerrar{% endtrans %}');
            deleteModel.item(
                'left',
                '{% trans %}Este proceso es irreversible{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{{ domain }}{% trans %}eliminar-item{% endtrans %}/{{ contentID }}/',
                function () {
                    window.location.reload();
                }
            );

            // block item
            var blockModel = new Namespace.Block('{% trans %}Error{% endtrans %}', '{% trans %}Cerrar{% endtrans %}', '{{ domain }}{% trans %}bloquear{% endtrans %}/{{ contentID }}/');
            blockModel.block(
                '{% trans %}¿Seguro que quieres bloquear este item?{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{% trans %}No se ha podido bloquear el item. Por favor, inténtalo más tarde.{% endtrans %}'
            );
            blockModel.unblock(
                '{% trans %}¿Seguro que quieres desbloquear este item?{% endtrans %}',
                '{% trans %}Sí{% endtrans %}',
                '{% trans %}No{% endtrans %}',
                '{% trans %}No se ha podido desbloquear el item. Por favor, inténtalo más tarde.{% endtrans %}'
            );

        });
    </script>
{% endblock %}

{% block page_content %}

    {% set createButton %}
        <div class="clearfix">
            {% include "Buttons/create.twig" %}
            {% include "Buttons/export.twig" %}
        </div>
    {% endset %}
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                {{ createButton }}
                <div class="box-body">
                    {% block list %}{% endblock %}
                </div>
                {{ createButton }}
            </div>
        </div>
    </div>

{% endblock %}