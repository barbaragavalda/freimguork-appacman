{% extends "basic-loggedin.twig" %}

{% block extra_head %}
    <!-- DataTables -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/datatables.net-bs/css/dataTables.bootstrap.min.css">
    {{ parent() }}
{% endblock %}

{% block extra_scripts %}
    {{ parent() }}
    <!-- DataTables -->
    <script src="{{ vendor_domain }}bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="{{ vendor_domain }}bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <script>
        var columns = [];
        {% for th in list_headers %}
            columns.push({ "orderable": true });
        {% endfor %}
        columns.push({ "orderable": false });
        $(function () {
            $('#list').DataTable({
                'paging'        : true,
                'lengthChange'  : true,
                'searching'     : true,
                'ordering'      : true,
                'info'          : true,
                'autoWidth'     : false,
                'pageLength'    : 25,
                'columns'       : columns,
                'order'         : {{ list_order|json_encode|raw }},
                'language'      : {
                    'lengthMenu': "{% trans %}Mostrar _MENU_ items por página{% endtrans %}",
                    'zeroRecords': "{% trans %}Sin resultados{% endtrans %}",
                    'info': "{% trans %}Mostrando _START_ a _END_ de _TOTAL_ entradas{% endtrans %}",
                    'infoEmpty': "{% trans %}No hay registros disponibles{% endtrans %}",
                    'search': "{% trans %}Buscar{% endtrans %}: ",
                    'infoFiltered': "{% trans %}(filtrado de _MAX_ entradas totales){% endtrans %}",
                    'paginate': {
                        'first': "{% trans %}Primero{% endtrans %}",
                        'last': "{% trans %}Último{% endtrans %}",
                        'previous': "{% trans %}Anterior{% endtrans %}",
                        'next': "{% trans %}Siguiente{% endtrans %}"
                    }
                }
            })
        })
    </script>
{% endblock %}

{% block page_content %}

    {% set createButton %}
        {% include "Buttons/create.twig" %}
    {% endset %}
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                {{ createButton }}
                <div class="box-body">
                    {% block list %}{% endblock %}
                </div>
                {{ createButton }}
            </div>
        </div>
    </div>

{% endblock %}