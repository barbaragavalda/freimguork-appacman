<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta name="robots" content="noindex">

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <link rel="shortcut icon" href="{{ static_domain }}static/img/favicon.ico" type="image/x-icon">

    {% set title = "" %}
    <title>{% block title %}{{ title }}{% endblock %}</title>

    <!-- Bootstrap 3.3.7 -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/bootstrap/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/font-awesome/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="{{ vendor_domain }}bower_components/Ionicons/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="{{ vendor_domain }}dist/css/AdminLTE.min.css">
    <!-- iCheck -->
    <link rel="stylesheet" href="{{ vendor_domain }}plugins/iCheck/square/blue.css">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->

    <!-- Google Font -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">

    {% block extra_head %}{% endblock %}

    <!-- Custom css -->
    <link rel="stylesheet" href="{{ admin_domain }}css/admin.css">
    <link rel="stylesheet" href="{{ admin_domain }}css/skin-custom.css">
</head>
<body class="hold-transition {% block body_class %}{% endblock %}">

    <div class="wrapper">
        {% block content %}{% endblock %}
    </div>

    <!-- jQuery 3 -->
    <script src="{{ vendor_domain }}bower_components/jquery/dist/jquery.min.js"></script>
    <!-- AdminLTE App -->
    <script src="{{ vendor_domain }}dist/js/adminlte.min.js"></script>
    {% block extra_scripts %}{% endblock %}
</body>
</html>