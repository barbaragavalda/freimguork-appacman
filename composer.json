{
  "name": "optisistem/freimguork-appacman",
  "description": "CMS module for Freimguork projects",
  "authors": [
    {
      "name": "Barbara Gavalda",
      "email": "bgb@optisistem.com"
    },
    {
      "name": "Toni Palanques",
      "email": "tpv@optisistem.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@bitbucket.org:optisistem/freimguork-core.git"
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:optisistem/php-ref.git"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-fileinfo": "*",
    "ext-gettext": "*",
    "ext-pdo": "*",
    "optisistem/freimguork-core": "dev-master || ^2.0",
    "almasaeed2010/adminlte": "~2.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "composer/composer": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Appacman\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Appacman\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M"
  },
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
